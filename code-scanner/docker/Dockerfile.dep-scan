# dep-scan — downloads a prebuilt release binary from GitHub
# No Rust toolchain needed. Build takes seconds, not minutes.
#
# Build (manual):
#   docker build -t dep-scan:latest -f code-scanner/docker/Dockerfile.dep-scan .
#
# The code-scanner skill auto-rebuilds this image when the Dockerfile changes
# using a SHA256 hash stored in the dev.code-scanner.dockerfile-hash label.

FROM ubuntu:24.04

LABEL dev.code-scanner.image-type="dep-scan"
LABEL dev.code-scanner.description="Supply chain dependency scanner for Code Scanner"
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl jq && \
    rm -rf /var/lib/apt/lists/*

# Single ecosystem pin: dep-scan's PINNED_VERSION channel (dep-scan task 113),
# consumed via dep-scan's own documented pattern (README "Version pinning for
# consumers"). Installed through dep-scan's install.sh, which does its own
# arch/OS detection and sha256sum-verifies the download against dep-scan's
# published checksums, rather than an independent tarball fetch in this file.
#
# Override for hermetic tests, deterministic CI builds, or emergency rollback:
#   docker build --build-arg DEP_SCAN_VERSION=v1.4.0 ...
ARG DEP_SCAN_VERSION=""
RUN VERSION="${DEP_SCAN_VERSION:-$(curl -fsSL https://raw.githubusercontent.com/tkdtaylor/dep-scan/main/PINNED_VERSION | tr -d '[:space:]')}" && \
    test -n "$VERSION" && \
    curl -fsSL https://raw.githubusercontent.com/tkdtaylor/dep-scan/main/install.sh \
      | INSTALL_DIR=/usr/local/bin bash -s -- --version="${VERSION}" && \
    dep-scan --version | grep -F -- "${VERSION#v}"
