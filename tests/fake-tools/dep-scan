#!/usr/bin/env python3
# Hermetic fake `dep-scan` for the L5 test harness. Emits the name-based array
# shape. `block` verdict on the vulnerable fixture, empty array when clean.
#
# Hardened to require the documented `--format json` contract and reject the
# deprecated `--json` alias: any regression in the real CLI back to `--json`
# must fail this hermetic suite loudly (rc 2, empty stdout) rather than pass
# silently (task 001).
#
# FAKE_DEPSCAN_MODE selects the vulnerable-fixture entry shape (task 002):
#   unset               today's fresh-scan shape (default; byte-compatible)
#   cached-attributed    dep-scan task 112 attributed cache hit (real version,
#                        full policies, additive `cache` object)
#   cached-legacy        pre-112 warm-cache sentinel (version "cached", empty
#                        policies)
import json
import os
import sys

argv = sys.argv[1:]

if "--json" in argv:
    print("fake dep-scan: deprecated flag --json is not supported here; "
          "use --format json", file=sys.stderr)
    sys.exit(2)

has_format_json = any(a == "--format" and b == "json"
                       for a, b in zip(argv, argv[1:]))
if not has_format_json:
    print("fake dep-scan: missing required --format json", file=sys.stderr)
    sys.exit(2)

ctx = " ".join(argv) + " " + os.getcwd()
is_vuln = "vulnerable" in ctx

mode = os.environ.get("FAKE_DEPSCAN_MODE", "")

if is_vuln:
    reason = "Found known vulnerability(ies): GHSA-8q59-q68h-6hv4, PYSEC-2021-142"
    if mode == "cached-attributed":
        # dep-scan task 112 shape: real version, full policies, additive `cache`
        # object (`cache.hit` always true when present; the entry is otherwise
        # indistinguishable from a fresh scan).
        entry = {
            "package": "PyYAML", "version": "5.3.1", "registry": "pypi",
            "result": "block", "reason": reason,
            "policies": [
                {"policy_name": "age", "result": "pass", "reason": None},
                {"policy_name": "vulnerability", "result": "block", "reason": reason},
            ],
            "cache": {"hit": True, "scanned_at": "2026-07-10T08:15:00Z",
                      "dep_scan_version": "1.3.1"},
        }
        print(json.dumps([entry]))
        sys.exit(1)
    if mode == "cached-legacy":
        # Pre-112 warm-cache sentinel: literal "cached" version, empty policies,
        # a bare top-level block. Real dep-scan still exits 1 here (its exit
        # code follows the top-level `result`, independent of attribution); the
        # consumer-side refusal to gate on it is code-scanner's own fail-closed
        # rule, exercised via `run_cli`'s exit code below, not this one.
        print(json.dumps([{
            "package": "PyYAML", "version": "cached", "registry": "pypi",
            "age_hours": None, "result": "block", "reason": "cached result",
            "policies": [],
        }]))
        sys.exit(1)
    print(json.dumps([{
        "package": "PyYAML", "version": "5.3.1", "registry": "pypi",
        "result": "block", "reason": reason,
        "policies": [
            {"policy_name": "age", "result": "pass", "reason": None},
            {"policy_name": "vulnerability", "result": "block", "reason": reason},
        ],
    }]))
    sys.exit(1)
else:
    print(json.dumps([]))
    sys.exit(0)
